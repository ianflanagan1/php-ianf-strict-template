# phpstan/extension-installer includes php-ianf-strict-baseline's config/phpstan.neon. List each script in bin/
# by name: PHPStan only finds .php files in a directory.
parameters:
    # Beside the other tools' caches, in cache/
    tmpDir: cache/phpstan
    # PHPStan's strictest. PHPStan reads the level, as it reads tmpDir, only from this file and what it includes
    # directly, so the baseline's config can't set it.
    level: 10
    checkMissingOverrideMethodAttribute: true
    paths:
        - src
        - bin/{{ project_name }}
        - tests
